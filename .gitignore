# ── Model PKL — terlalu besar untuk GitHub (upload manual ke PythonAnywhere) ─
backend/app/model/trained/*.pkl

# ── Data dinamis dari notebook — upload manual ke PythonAnywhere ─────────────
backend/app/data/static/rf_static_data.py
backend/app/data/batch/simulasi_batch_19kec.geojson
backend/app/data/batch/ringkasan_batch_19kec.json

# ── GeoJSON kecamatan detail — upload manual ke PythonAnywhere ───────────────
backend/app/data/geojson/*.geojson

# ── CATATAN: frontend/geojson/kecamatan_semarang.geojson WAJIB ikut GitHub ───
# (file ini digunakan oleh peta interaktif — tidak boleh dikecualikan)

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── File tidak perlu di repository ───────────────────────────────────────────
vercel.json
PANDUAN_REVISI_*.md
SIMULASI_LONGSOR_*.ipynb
*.log
*.tmp

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

